INVESTO_PORT=8080
INVESTO_DB_HOST=127.0.0.1
INVESTO_DB_PORT=3306
INVESTO_DB_USER=investo
INVESTO_DB_PASS=generate-a-strong-database-password
INVESTO_DB_NAME=investo
INVESTO_REDIS_ADDR=127.0.0.1:6379
INVESTO_REDIS_PASSWORD=
INVESTO_APP_NAME=Investo
INVESTO_APP_URL=https://investo.whitelabel.co.id
INVESTO_APP_ENV=development
# Production requires two different random secrets of at least 32 characters.
INVESTO_JWT_SECRET=generate-a-unique-random-secret-of-32-plus-characters
INVESTO_SESSION_SECRET=generate-a-different-random-secret-of-32-plus-characters

# Docker Compose only. Keep the database bound to its internal network.
MYSQL_ROOT_PASSWORD=generate-a-different-strong-root-password
INVESTO_BIND_ADDRESS=127.0.0.1
INVESTO_HOST_PORT=8000

# AI (BYOK) — opsional. Bisa juga di-set via admin UI /pengaturan/ai
# Provider: openai, deepseek, claude, gemini, groq, qwen, glm, minimax,
#           openrouter, azure, ollama, openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DEEP_MODEL=
AI_QUICK_MODEL=
AI_TEMPERATURE=0.7

# Data provider fallback (opsional) — dipakai kalau Yahoo Finance gagal
FMP_API_KEY=
